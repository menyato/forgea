#!/bin/sh
# /usr/local/sbin/forgea-deploy (root-owned, installed by deploy/sync-config.sh). Runs as the
# `deploy` user, started either by GitHub through forgea-deploy-gate or by hand to roll back:
#   forgea-deploy <production|staging> <sha-1a2b3c4>
# From GitHub the registry token comes on stdin. By hand (a rollback), log in once first with a
# GitHub token that can read packages: docker login ghcr.io -u <your GitHub name>
# Pulls that version's images, applies database migrations, then replaces that environment's
# containers. If migrations fail, nothing is replaced and the running version keeps serving;
# if the new version doesn't come up healthy, the previous one is started again. Production
# is backed up first. Never at the same time as a backup or restore of that environment.
# The other environment and the shared front door are never touched.
set -eu
# A dropped SSH connection (GitHub's job timing out) must not stop a deploy half-way.
trap '' HUP

ENV_NAME="${1:-}"
TAG="${2:-}"
case "$ENV_NAME" in production | staging) ;; *) echo "Unknown environment" >&2; exit 2 ;; esac
case "$TAG" in
  sha-[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]) ;;
  *) echo "Not an image tag" >&2; exit 2 ;;
esac
cd "/srv/forgea/$ENV_NAME"

# The folder and its settings must agree, or staging could start on production's data.
grep -qx "ENV_NAME=$ENV_NAME" .env || { echo ".env does not say ENV_NAME=$ENV_NAME" >&2; exit 3; }
grep -q "^API_URL=http://$ENV_NAME-api:" web.env || { echo "web.env must use $ENV_NAME-api" >&2; exit 3; }

export TAG
# From GitHub: a registry login just for this run (its token lives only as long as the job).
if [ ! -t 0 ]; then
  token="$(cat)"
  if [ -n "$token" ]; then
    DOCKER_CONFIG="$(mktemp -d)"
    export DOCKER_CONFIG
    trap 'rm -rf "$DOCKER_CONFIG"' EXIT
    printf '%s' "$token" | docker login ghcr.io -u github --password-stdin >/dev/null
  fi
fi

docker compose --profile tools pull --quiet

# Production: a backup of the state before this release (restorable from the dashboard).
if [ "$ENV_NAME" = production ]; then
  ./backup.sh now predeploy || { echo "The pre-deploy backup failed: not deploying" >&2; exit 5; }
fi

# One at a time with backups and restores (a migration waiting behind a nightly dump would
# hold every query of the site behind it): wait up to 15 minutes for one that is running.
exec 9>"backups/.lock"
flock -w 900 9 || { echo "A backup or restore is still running: try again later" >&2; exit 4; }

previous="$(sed -n 's/^TAG=//p' .env)"
docker compose run --rm migrate
if ! docker compose up --detach --remove-orphans --wait; then
  echo "$TAG did not come up healthy: starting $previous again" >&2
  if [ -n "$previous" ]; then
    TAG="$previous" docker compose up --detach --remove-orphans --wait || true
  fi
  exit 6
fi

# Recorded only once the new version is up, so a restart never picks a half-deployed one.
sed -i "s/^TAG=.*/TAG=$TAG/" .env

# Each release is ~3 GB, and there can be several a day: keep only what either environment
# runs now plus the two newest releases (a quick rollback), and nothing untagged.
in_use="$(sed -n 's/^TAG=//p' /srv/forgea/production/.env /srv/forgea/staging/.env 2>/dev/null)"
for repo in $(docker images --format '{{.Repository}}' | grep '^ghcr.io/menyato/forgea-' | sort -u); do
  docker images "$repo" --format '{{.CreatedAt}}|{{.Tag}}' | sort -r | cut -d'|' -f2 | tail -n +3 |
    while read -r tag; do
      echo "$in_use" | grep -qx "$tag" || docker rmi "$repo:$tag" >/dev/null 2>&1 || true
    done
done
docker image prune --force >/dev/null
echo "Deployed $TAG to $ENV_NAME"
