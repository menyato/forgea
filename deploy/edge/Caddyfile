# Only Cloudflare connects here (the server firewall admits Cloudflare's addresses only), over
# HTTPS with Cloudflare's origin certificate ("Full (strict)" in Cloudflare → SSL/TLS), and
# Cloudflare must prove it is OUR Cloudflare zone (Authenticated Origin Pulls): requests through
# any other Cloudflare customer's account are refused.
{
	admin off
	auto_https off
	servers {
		# The visitor's real address, for logs; the apps read CF-Connecting-IP themselves.
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP
	}
}

# Cloudflare's origin certificate, and Cloudflare's client certificate required.
(origin-tls) {
	tls /certs/origin.pem /certs/origin-key.pem {
		client_auth {
			mode require_and_verify
			trust_pool file /certs/origin-pull-ca.pem
		}
	}
}

# One environment: its storefront, plus the API for Google sign-in only. The API has no address
# of its own; sign-in must land on the site's host so its cookies are that site's alone
# (production and staging never share sessions). Everything else goes to the storefront,
# which calls its API inside the server.
(environment) {
	import origin-tls
	@google path /auth/google /auth/google/callback
	handle @google {
		reverse_proxy {args[0]}-api:3000
	}
	handle {
		reverse_proxy {args[0]}-web:3000
	}
	# Request sizes per page: big files only where they are uploaded (the API's 100 MB ceiling;
	# Cloudflare's free plan also stops at 100 MB), a picture on the idea form, 1 MB elsewhere.
	# (Forms sent from the page post to "<page>.data", e.g. /custom.data.)
	@uploads path /custom /custom.data /custom/* /admin /admin.data /admin/*
	@contact path /contact /contact.data
	@other not path /custom /custom.data /custom/* /admin /admin.data /admin/* /contact /contact.data
	request_body @uploads {
		max_size 101MB
	}
	request_body @contact {
		max_size 11MB
	}
	request_body @other {
		max_size 1MB
	}
	header {
		-Server
		# HTTPS only, for a year (Cloudflare serves HTTPS on every forgea-lab.com name).
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		# No other site may frame the shop (clickjacking); no plugins; forms post only here; the
		# page fetches and shows images only from this site (a 3D file can't call out).
		# Scripts are left to the app: React Router's hydration uses inline scripts.
		Content-Security-Policy "frame-ancestors 'none'; base-uri 'self'; form-action 'self' https://accounts.google.com; object-src 'none'; connect-src 'self'; img-src 'self' data: blob:"
		X-Frame-Options DENY
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
	}
	log {
		output stdout
		format json
	}
}

https://{$PRODUCTION_HOST}:443 {
	import environment production
}

https://{$STAGING_HOST}:443 {
	import environment staging
	# Keep search engines off the rehearsal copy.
	header X-Robots-Tag "noindex, nofollow"
}

https://www.{$PRODUCTION_HOST}:443 {
	import origin-tls
	redir https://{$PRODUCTION_HOST}{uri} permanent
}
