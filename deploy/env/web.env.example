# /srv/forgea/<production|staging>/web.env (chmod 600). Never commit the real file.
NODE_ENV=production
PORT=3000
# Server to server, inside the Docker network: browsers never call the API.
API_URL=http://production-api:3000
# Staging: http://staging-api:3000. Each storefront talks only to its own API.
# Staging: https://staging.forgea-lab.com for both.
PUBLIC_API_URL=https://forgea-lab.com
PUBLIC_WEB_URL=https://forgea-lab.com
# Same value as in api.env.
INTERNAL_PROXY_SECRET=
TRUST_CLOUDFLARE=true
