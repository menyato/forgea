# /srv/forgea/<production|staging>/.env: what Docker Compose fills into compose.yaml.
# TAG is rewritten by every deploy; the rest is set once.
ENV_NAME=production
IMAGE_PREFIX=ghcr.io/menyato/forgea
TAG=

# Memory caps. Production as below; staging lower, so it can never starve production:
#   WEB_MEMORY=384m  API_MEMORY=1536m  DB_MEMORY=512m  DB_OOM_SCORE_ADJ=0
WEB_MEMORY=512m
API_MEMORY=2g
DB_MEMORY=1g
DB_OOM_SCORE_ADJ=-500
