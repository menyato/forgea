# /srv/forgea/<production|staging>/backup.env (chmod 600). Used by backup.sh.
# Backups go to a private Google Cloud Storage bucket, encrypted by restic before they leave
# the server (Google only ever sees encrypted data). One bucket per environment.
# Staging: gs:forgea-backups-staging:/
RESTIC_REPOSITORY=gs:forgea-backups-production:/
# Keep this password somewhere safe outside the server too: without it backups can't be read.
RESTIC_PASSWORD=
GOOGLE_PROJECT_ID=
# The service account key (allowed only "Storage Object Admin" on that one bucket) sits next to
# this file as backup-key.json (chmod 600); backup.sh hands it to restic.
