# /srv/forgea/<production|staging>/backup.env (chmod 600). Used by backup.sh.
# Backups stay on this server (./backups, the newest N, set on the dashboard's Backups page)
# and are downloaded from there to your PC. Each is encrypted with this password before it is
# written: keep it in your password manager too. Without it a backup can't be restored.
BACKUP_PASSWORD=
# Optional: a free check at https://healthchecks.io (or similar) that emails you when a night's
# backup didn't report in. Paste its ping URL here.
HEALTHCHECK_URL=
