# /srv/forgea/<production|staging>/api.env (chmod 600). Never commit the real file.
# Production values shown; staging differs where marked.
NODE_ENV=production
PORT=3000

# Same password as APP_DB_PASSWORD in db.env. "postgres" is the database container's name.
DATABASE_URL=postgresql://forgea_app:CHANGE_ME@postgres:5432/forgea?schema=public

# Staging: https://staging.forgea-lab.com for both.
PUBLIC_WEB_URL=https://forgea-lab.com
# The API is served from the site's host for Google sign-in (deploy/Caddyfile).
PUBLIC_API_URL=https://forgea-lab.com

# Each: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Different on staging and production.
JWT_ACCESS_SECRET=
COOKIE_SECRET=
# Same value as in web.env.
INTERNAL_PROXY_SECRET=

# Google sign-in. Authorized redirect URI: ${PUBLIC_API_URL}/auth/google/callback
# (add both the production and the staging one to the same OAuth client).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
WORKSPACE_DOMAIN=forgea-lab.com
BOOTSTRAP_ADMIN_EMAIL=

# Only Cloudflare reaches the server, so its CF-Connecting-IP header is the visitor's address.
TRUST_CLOUDFLARE=true

# Gmail and Calendar (docs/BACK_OFFICE.md). Empty: emails are kept as files in the outbox volume.
GOOGLE_SERVICE_ACCOUNT_KEY=
MAIL_SENDER=
GOOGLE_CALENDAR_ID=
