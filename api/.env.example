# Copy to api/.env for local development. Never commit api/.env.
# On the servers the values come from /srv/forgea/api.env (template: deploy/env/api.env.example).

# Dedicated least-privilege role and database (see docs/LOCAL_SETUP.md).
DATABASE_URL="postgresql://forgea_app:CHANGE_ME@localhost:5432/forgea?schema=public"
# Separate database for `pnpm test:e2e`; migrated automatically before the tests run.
TEST_DATABASE_URL="postgresql://forgea_app:CHANGE_ME@localhost:5432/forgea_test?schema=public"

PORT=3000
NODE_ENV=development
PUBLIC_WEB_URL=http://localhost:5173
PUBLIC_API_URL=http://localhost:3000
DEV_CORS_ORIGINS=http://localhost:5173

# Generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
COOKIE_SECRET=

# Google OAuth client (Google Cloud console → APIs & Services → Credentials, type "Web application").
# Authorized redirect URI: ${PUBLIC_API_URL}/auth/google/callback. Leave empty to disable Google sign-in locally.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
WORKSPACE_DOMAIN=forgea-lab.com
# The first Workspace account with this email to sign in becomes ADMIN (only while no admin exists).
BOOTSTRAP_ADMIN_EMAIL=

# Servers only: TRUST_CLOUDFLARE=true (their firewall admits Cloudflare alone).

# Shared with web/.env; the storefront forwards each shopper's IP with it (rate limiting).
INTERNAL_PROXY_SECRET=

# Uploaded files: a local folder here; a private Docker volume on the servers.
UPLOAD_DIR=.uploads

# Gmail and Calendar (docs/BACK_OFFICE.md). Leave the key empty locally: emails are then
# written as .eml files to MAIL_OUTBOX_DIR and calendar changes are only logged.
# The key is the service account's JSON key file contents, on one line.
GOOGLE_SERVICE_ACCOUNT_KEY=
MAIL_SENDER=
MAIL_OUTBOX_DIR=.outbox
GOOGLE_CALENDAR_ID=
# Where alerts about new orders, custom requests and ideas go (empty: MAIL_SENDER).
STUDIO_NOTIFY_EMAIL=
