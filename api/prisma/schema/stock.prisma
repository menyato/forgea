/// Filament on the shelf, per material and colour: spools are bought that way. Its stock is
/// the sum of its movements (never a number someone types in); `materials.stockGrams` is the
/// material's total, kept by a database trigger. Every limit here is the owner's to edit.
model StockItem {
  id            String   @id @default(uuid(7)) @db.Uuid
  materialId    String   @db.Uuid
  material      Material @relation(fields: [materialId], references: [id], onDelete: Restrict)
  /// The colour as the shop names it (an option value with a swatch); "" when none was chosen.
  colour        String   @default("")
  /// How the colour looks (#rrggbb, CHECK), chosen when the spools come in; null = the shop's
  /// swatch of that name, if any.
  hex           String?
  /// What a gram of this filament costs (USD), from its own spools as bought; null = the
  /// material's price. Above 0 (CHECK).
  pricePerGram  Decimal? @db.Decimal(10, 4)
  /// Restock when what is left (after open orders) is at or below this.
  lowStockGrams Int
  /// What one spool holds: suggestions are in whole spools.
  spoolGrams    Int      @default(1000)
  /// How many days a new delivery takes to arrive.
  leadTimeDays  Int      @default(7)
  /// How many days of use a delivery should cover beyond the lead time.
  coverDays     Int      @default(30)
  active        Boolean  @default(true)
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @db.Timestamptz(3)

  movements StockMovement[]
  /// Product colours printed from this filament.
  productColours ProductColour[]
  /// The shop's colours printed from this filament.
  optionValues   OptionValue[]
  printJobs PrintJob[]

  @@unique([materialId, colour])
  @@map("stock_items")
}

enum StockMovementKind {
  /// The stock there was when tracking started.
  OPENING
  /// A delivery of new spools.
  RECEIVED
  /// An order went into production: its products' grams (size and options included).
  ORDER
  /// A print that failed: the filament it used is lost.
  FAILED_PRINT
  /// Used for something else (custom work, tests, samples), recorded by the team.
  USED
  /// Stock counted or weighed: the difference, either way.
  CORRECTION
  /// A finished print job: what it took beyond (or short of) its order's estimate, either way;
  /// all of it for a job that isn't an order line.
  PRINTED
  /// An order cancelled before printing all of it: the filament it took that wasn't used.
  RETURNED
}

/// Append-only (a trigger refuses changes): every gram in or out, with why and who.
/// `grams` is signed: + in, − out (CHECK constraint per kind).
model StockMovement {
  id             String            @id @default(uuid(7)) @db.Uuid
  stockItemId    String            @db.Uuid
  stockItem      StockItem         @relation(fields: [stockItemId], references: [id], onDelete: Restrict)
  kind           StockMovementKind
  grams          Int
  /// ORDER: the order line it was used for (once per line: unique index).
  orderItemId    String?           @db.Uuid
  orderItem      OrderItem?        @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  printJobId     String?           @db.Uuid
  printJob       PrintJob?         @relation(fields: [printJobId], references: [id], onDelete: Restrict)
  /// What it cost, USD, worked out when recorded: a delivery's price paid; filament used
  /// (studio prints, failed prints) at the material's cost per gram plus machine time.
  cost           Decimal?          @db.Decimal(10, 2)
  /// The filament's cost per gram when recorded (a delivery: its own price per gram).
  costPerGram    Decimal?          @db.Decimal(10, 4)
  /// USED or FAILED_PRINT for a product (printed for the studio, or failed): which, how many.
  productId      String?           @db.Uuid
  product        Product?          @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity       Int?
  /// RECEIVED and paid: the expense entry it was booked with.
  journalEntryId String?           @db.Uuid
  journalEntry   JournalEntry?     @relation(fields: [journalEntryId], references: [id], onDelete: Restrict)
  note           String?
  createdById    String?           @db.Uuid
  createdBy      User?             @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdAt      DateTime          @default(now()) @db.Timestamptz(3)

  @@index([stockItemId, createdAt])
  @@index([createdAt])
  @@index([orderItemId])
  @@map("stock_movements")
}

enum ReadyPieceMovementKind {
  /// Printed for the shelf (a studio print, a full plate's spare pieces).
  PRINTED
  /// Printed for an order that was then cancelled.
  LEFT_OVER
  /// Added by hand (printed outside the planner, a custom design kept).
  ADDED
  /// Sold (in an order, at a market, to a walk-in).
  SOLD
  /// Given away, kept as a sample or for display.
  USED
  /// Broken or not good enough to sell.
  SCRAPPED
  /// Counted on the shelf: the difference, either way.
  COUNTED
}

/// Pieces printed and not sold yet, by what they are: a product with its colour and size, or a
/// custom design. `onHand` and `unitCost` (average cost of the pieces in) follow the movements.
model ReadyPiece {
  id        String   @id @default(uuid(7)) @db.Uuid
  /// The catalog product, when it is one; null for a custom design.
  productId String?  @db.Uuid
  product   Product? @relation(fields: [productId], references: [id], onDelete: Restrict)
  name      String
  /// Colour, size, the text of a personalised piece: what tells these pieces apart.
  details   String   @default("")
  onHand    Int      @default(0)
  unitCost  Decimal  @default(0) @db.Decimal(10, 2)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  movements ReadyPieceMovement[]

  @@unique([productId, name, details])
  @@map("ready_pieces")
}

/// Append-only (a trigger refuses changes): every piece onto or off the shelf, why and who.
model ReadyPieceMovement {
  id           String                 @id @default(uuid(7)) @db.Uuid
  readyPieceId String                 @db.Uuid
  readyPiece   ReadyPiece             @relation(fields: [readyPieceId], references: [id], onDelete: Restrict)
  kind         ReadyPieceMovementKind
  /// Signed: + onto the shelf, − off it.
  quantity     Int
  /// Cost of one piece: what it cost to make (in), the shelf's average (out).
  unitCost     Decimal                @db.Decimal(10, 2)
  printJobId   String?                @db.Uuid
  printJob     PrintJob?              @relation(fields: [printJobId], references: [id], onDelete: Restrict)
  /// The order it was printed for (left over) or sold in.
  orderId      String?                @db.Uuid
  order        Order?                 @relation(fields: [orderId], references: [id], onDelete: Restrict)
  note         String?
  createdById  String?                @db.Uuid
  createdBy    User?                  @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdAt    DateTime               @default(now()) @db.Timestamptz(3)

  @@index([readyPieceId, createdAt])
  @@index([createdAt])
  @@map("ready_piece_movements")
}

/// A form's one-time key, claimed in the same transaction as what the form records: the
/// same form sent twice (a double click, a retried request) records it once.
model RequestKey {
  key       String   @id @db.Uuid
  scope     String
  /// What the first submission made (its id), for the second to return.
  result    String?
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@map("request_keys")
}
