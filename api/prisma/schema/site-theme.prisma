/// The palette the owner picked in the dashboard (Phase 8 theme control). At most one row
/// (id = 1); no row means the default palette from packages/brand/src/tokens.ts.
model SiteTheme {
  id              Int      @id @default(1)
  /// The palette's raw colours (packages/brand `Palette`, every value #rrggbb). The API
  /// refuses a palette that fails the same contrast checks as the built-in palettes.
  palette         Json
  /// The built-in palette it started from (e.g. "copper"), for the editor.
  basedOn         String
  updatedAt       DateTime @updatedAt @db.Timestamptz(3)
  updatedByUserId String?  @db.Uuid
  updatedBy       User?    @relation(fields: [updatedByUserId], references: [id], onDelete: Restrict)

  @@map("site_theme")
}

/// Palettes the owner kept under a name, to switch the site to later (Dashboard → Theme).
/// Saving one changes nothing on the site; applying it writes it to SiteTheme.
model SavedTheme {
  id          String   @id @default(uuid(7)) @db.Uuid
  /// 1–60 characters (CHECK constraint); unique, so the list reads clearly.
  name        String   @unique
  /// packages/brand `Palette`, every value #rrggbb (checked by the API).
  palette     Json
  basedOn     String
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  createdById String?  @db.Uuid
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@map("saved_themes")
}
