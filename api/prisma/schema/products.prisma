model Product {
  id           String    @id @default(uuid(7)) @db.Uuid
  /// Public URL segment for the product page.
  slug         String    @unique
  name         String
  description  String
  categoryId   String?   @db.Uuid
  category     Category? @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  /// Cloud Storage object keys of reference images, in display order.
  imageKeys    String[]
  /// Cloud Storage object key of the .glb or .stl model shown in 3D.
  modelFileKey String?
  /// Its place on the home page's print bed (1 = the centre, 2–5 the corners), chosen in the
  /// dashboard; null = not on the bed.
  plateOrder   Int?      @unique

  // Base pricing inputs fed to @forgea/pricing.
  grams      Decimal  @db.Decimal(10, 2)
  printHours Decimal  @db.Decimal(8, 2)
  materialId String   @db.Uuid
  material   Material @relation(fields: [materialId], references: [id], onDelete: Restrict)
  /// The printed size, in cm, that grams and printHours are for (measured from the 3D model):
  /// width × depth × height, all three or none (CHECK constraint).
  sizeXcm    Decimal? @db.Decimal(7, 1)
  sizeYcm    Decimal? @db.Decimal(7, 1)
  sizeZcm    Decimal? @db.Decimal(7, 1)

  /// Its own profit rule; both null = the shop's (Pricing page). Both or neither (CHECK).
  profitKind    ProfitKind?
  profitValue   Decimal?    @db.Decimal(10, 2)
  /// Its grams and printHours are its sliced 3MF's own (set by the API when they match the
  /// file): they already hold the purge, prime tower and supports, so no purge waste is added.
  slicedFile Boolean @default(false)
  /// The owner's own selling price (USD) in place of the calculated one; null = calculated.
  /// Sizes and options still add what they change in the calculated price. Above 0 (CHECK).
  priceOverride Decimal?    @db.Decimal(10, 2)

  /// Personalised: the customer types their text and sees it in 3D (null = a regular product).
  /// The pieces are made from the text (@forgea/text3d), not from a model file; grams and
  /// hours come from the piece's volume. All set together (CHECK).
  textStyle            TextStyle?
  textMaxChars         Int?
  /// Letter height (cap height), letter thickness, backing thickness, widest piece: mm.
  textHeightMm         Decimal?     @db.Decimal(6, 1)
  textDepthMm          Decimal?     @db.Decimal(5, 1)
  textBaseMm           Decimal?     @db.Decimal(5, 1)
  textMaxWidthMm       Decimal?     @db.Decimal(6, 1)
  /// The colours customers choose from: an option group with swatches.
  textColourGroupId    String?      @db.Uuid
  textColourGroup      OptionGroup? @relation("TextColours", fields: [textColourGroupId], references: [id], onDelete: Restrict)
  /// More letter heights customers may choose (mm); textHeightMm is the default one.
  textSizesMm          Decimal[]    @default([]) @db.Decimal(6, 1)
  /// The colours a design starts with: the letters', and the backing's (null = the letters').
  textDefaultColourId  String?      @db.Uuid
  textDefaultColour    OptionValue? @relation("TextDefaultColour", fields: [textDefaultColourId], references: [id], onDelete: SetNull)
  textDefaultBaseId    String?      @db.Uuid
  textDefaultBase      OptionValue? @relation("TextDefaultBase", fields: [textDefaultBaseId], references: [id], onDelete: SetNull)
  /// Big initial and couple pieces: the accent's starting colour (the initial and decorations,
  /// or the heart); null = the letters'.
  textDefaultAccentId  String?      @db.Uuid
  textDefaultAccent    OptionValue? @relation("TextDefaultAccent", fields: [textDefaultAccentId], references: [id], onDelete: SetNull)
  /// Big initial pieces: the decorations around the initial (set only for INITIAL_NAME, CHECK).
  textDecor            TextDecor?
  /// Added for every colour beyond the first (a multi-colour print), USD.
  textExtraColourPrice Decimal      @default(0) @db.Decimal(10, 2)

  /// Multi-colour (3MF): the colours customers may recolour its named parts in (an option group
  /// with swatches; each value's add-on is that colour's price). Set when a part is named.
  partColourGroupId String?      @db.Uuid
  partColourGroup   OptionGroup? @relation("PartColours", fields: [partColourGroupId], references: [id], onDelete: Restrict)

  /// Made to order for the customer: requires the 50% deposit at checkout.
  isCustom  Boolean  @default(false)
  /// "Designed by …" on the product page: a studio or guest designer, by name.
  designer  String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  cartItems      CartItem[]
  orderItems     OrderItem[]
  optionGroups   ProductOptionGroup[]
  optionValues   ProductOptionValue[]
  quotationLines QuotationLine[]
  sizes          ProductSize[]
  colours        ProductColour[]
  printFiles     ProductPrintFile[]
  stockMovements StockMovement[]
  readyPieces    ReadyPiece[]

  @@index([active, id])
  @@index([categoryId])
  @@map("products")
}

/// A real size the product is sold in: its measurements and what it takes to print at that
/// size. Choosing it prices the product with these grams and hours instead of the base ones.
/// One may be the default (unique partial index); none means the product has one size.
model ProductSize {
  id         String  @id @default(uuid(7)) @db.Uuid
  productId  String  @db.Uuid
  product    Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  /// Small, Large, A5…: what the customer picks.
  label      String
  /// Width × depth × height in cm, each above 0 (CHECK constraint).
  sizeXcm    Decimal @db.Decimal(7, 1)
  sizeYcm    Decimal @db.Decimal(7, 1)
  sizeZcm    Decimal @db.Decimal(7, 1)
  grams      Decimal @db.Decimal(10, 2)
  printHours Decimal @db.Decimal(8, 2)
  isDefault  Boolean @default(false)
  sortOrder  Int     @default(0)

  @@unique([productId, label])
  @@map("product_sizes")
}

/// A multi-colour product (from its 3MF): what each filament colour takes for one piece at the
/// product's own size. They add up to the product's grams; orders take each from its colour's
/// stock (scaled with the chosen size and options).
model ProductColour {
  id        String  @id @default(uuid(7)) @db.Uuid
  productId String  @db.Uuid
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  /// The colour as the shop names it (an option value with a swatch): its stock line, and the
  /// part's starting colour when customers choose it.
  colour    String
  /// What customers call this part ("Body", "Ears"): they choose its colour from the product's
  /// part colours. Null = it always prints in `colour`. 1–40 characters (CHECK).
  part      String?
  /// The part colours' choice it starts in on the product page (its label), as the owner
  /// picked it; null = automatic (`startingChoice`: same filament, same name, closest colour).
  /// 1–40 characters (CHECK).
  startsAs  String?
  /// The file's colour, #RRGGBB (CHECK), for the swatch.
  hex       String
  /// Above 0 (CHECK).
  grams     Decimal @db.Decimal(10, 2)
  /// The filament on the shelf this colour is printed from (its material, name and price):
  /// stock takes its grams there and its cost uses that filament's price. Null = the product's
  /// material in the colour named.
  stockItemId String?    @db.Uuid
  stockItem   StockItem? @relation(fields: [stockItemId], references: [id], onDelete: SetNull)
  sortOrder Int     @default(0)

  @@unique([productId, colour])
  @@map("product_colours")
}

/// A sliced print file of a product (a Bambu Studio `.gcode.3mf`): the product may be shown
/// assembled (its model) and printed from one or more of these. Each keeps what the slicer
/// says it takes; together they are the product's grams, time and colours. Staff only: the
/// shop never gets these files.
model ProductPrintFile {
  id         String  @id @default(uuid(7)) @db.Uuid
  productId  String  @db.Uuid
  product    Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  /// Object key of the sliced 3MF (clean/<id>.3mf).
  fileKey    String
  /// What the owner calls it ("Base", "Shade"): 1–80 characters (CHECK).
  name       String
  /// The slicer's grams (purge, prime tower and supports included) and hours. Above 0 (CHECK).
  grams      Decimal @db.Decimal(10, 2)
  printHours Decimal @db.Decimal(8, 2)
  /// Read from the file by the API: `{ colours: [{ colour, hex, type, grams }], setup }`
  /// (PrintFileDetails). An object (CHECK).
  details    Json
  sortOrder  Int     @default(0)

  @@unique([productId, fileKey])
  @@map("product_print_files")
}
