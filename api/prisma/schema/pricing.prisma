/// Admin-editable pricing constants, read by @forgea/pricing. Exactly one row (id = 1),
/// created by the migration that introduced it; the API only ever updates it.
/// Cost fields are server-only; the order fields are sent to the browser for live totals.
model PricingSettings {
  id Int @id @default(1)

  // Cost model (UnitCostCalculator) — never exposed publicly.
  machineRatePerHour      Decimal    @db.Decimal(10, 2)
  purgeWastePercent       Decimal    @db.Decimal(5, 2)
  failureAllowancePercent Decimal    @db.Decimal(5, 2)
  laborCostPerUnit        Decimal    @db.Decimal(10, 2)
  packagingCostPerUnit    Decimal    @db.Decimal(10, 2)
  /// The shop's profit rule on top of cost; a product may set its own.
  profitKind              ProfitKind @default(PERCENT)
  profitValue             Decimal    @db.Decimal(10, 2)
  /// What shop prices round to, half up (USD): 1.00 = whole dollars ($4.70 → $5, $4.40 → $4).
  priceStep               Decimal    @default(1) @db.Decimal(10, 2)

  /// What a kWh of electricity costs the studio (USD): print jobs' electricity, and with the
  /// pricing printer the hourly cost of printer time.
  electricityPerKwh Decimal? @db.Decimal(8, 4)
  /// The printer prices are worked out from: its price over its life (wear) and its watts at
  /// `electricityPerKwh`, read from the printer itself (Dashboard → Printers), so they are
  /// entered once. Null: the owner types machineRatePerHour directly.
  pricingPrinterId  String?  @db.Uuid
  pricingPrinter    Printer? @relation(fields: [pricingPrinterId], references: [id], onDelete: SetNull)

  // Order level (OrderPricer) — customer-facing.
  rushFeePercent    Decimal  @db.Decimal(5, 2)
  deliveryFee       Decimal  @db.Decimal(10, 2)
  depositPercent    Decimal  @db.Decimal(5, 2)
  /// Whether checkout asks for a deposit at all (one switch to turn it off).
  depositEnabled    Boolean  @default(true)
  /// Orders whose items come to more than this (USD) pay `depositPercent` of them upfront;
  /// null: no amount rule. Above 0 (CHECK).
  depositAboveTotal Decimal? @default(30) @db.Decimal(10, 2)
  /// Made-to-order lines always pay the deposit on themselves, whatever the order's total.
  depositOnCustom   Boolean  @default(false)

  updatedAt       DateTime @updatedAt @db.Timestamptz(3)
  updatedByUserId String?  @db.Uuid
  updatedBy       User?    @relation(fields: [updatedByUserId], references: [id], onDelete: Restrict)

  @@map("pricing_settings")
}

/// Per-line bulk discount: a cart line of at least `minQuantity` units gets `percent` off.
model BulkDiscountTier {
  id          String   @id @default(uuid(7)) @db.Uuid
  minQuantity Int      @unique
  percent     Decimal  @db.Decimal(5, 2)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  @@map("bulk_discount_tiers")
}

/// A percentage of the cost, or a fixed amount in USD (@forgea/pricing ProfitRule).
enum ProfitKind {
  PERCENT
  FIXED
}
