enum Role {
  ADMIN
  /// Orders, production, custom requests and their quotes.
  STAFF
  /// The design team: the catalog (products, 3D models, options) and design previews for
  /// custom requests. No money settings, team or quotes.
  DESIGNER
  CUSTOMER
}

/// Admins and staff sign in only with Google Workspace (googleId set, passwordHash null).
/// Customers use Google, email + password (argon2 passwordHash), or both.
model User {
  id                 String    @id @default(uuid(7)) @db.Uuid
  /// Stored lowercased by the users service; uniqueness relies on that normalization.
  email              String    @unique
  name               String?
  /// Asked at checkout and remembered for the next order; staff call before delivering.
  phone              String?
  googleId           String?   @unique
  /// argon2id. Only CUSTOMER accounts may have one (CHECK constraint): staff sign in with Google only.
  passwordHash       String?
  /// Set when Google confirms the email, or when the customer enters the code emailed at sign-up.
  emailVerifiedAt    DateTime? @db.Timestamptz(3)
  role               Role      @default(CUSTOMER)
  /// Permissions given to this team member on top of their role (keys from @forgea/types).
  grantedPermissions String[]  @default([])
  /// Permissions taken away from this team member; a denial beats the role and a grant.
  deniedPermissions  String[]  @default([])
  /// Team accounts an admin switched off: they can't sign in and their sessions are ended.
  disabledAt         DateTime? @db.Timestamptz(3)
  createdAt          DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime  @updatedAt @db.Timestamptz(3)

  cart                Cart?
  orders              Order[]
  statusChanges       OrderStatusHistory[]
  auditEntries        AuditLog[]
  pricingEdits        PricingSettings[]
  sessions            Session[]
  emailCode           EmailCode?
  uploads             Upload[]
  ratesSet            ExchangeRate[]
  storeSettingsEdits  StoreSettings[]
  themeEdits          SiteTheme[]
  customRequests      CustomRequest[]              @relation("CustomRequestOwner")
  quotesSent          CustomRequest[]              @relation("CustomRequestQuotedBy")
  requestChanges      CustomRequestStatusHistory[]
  assignedLeads       Lead[]                       @relation("LeadAssignee")
  customerLeads       Lead[]                       @relation("LeadCustomer")
  assignedActivities  LeadActivity[]               @relation("ActivityAssignee")
  createdActivities   LeadActivity[]               @relation("ActivityCreator")
  leadNotes           LeadNote[]
  quotations          Quotation[]                  @relation("QuotationCustomer")
  quotationsWritten   Quotation[]                  @relation("QuotationAuthor")
  quotationChanges    QuotationStatusHistory[]
  journalEntries      JournalEntry[]               @relation("EntryCustomer")
  entriesPosted       JournalEntry[]               @relation("EntryPoster")
  journalLines        JournalLine[]                @relation("LineCustomer")
  rolePermissionEdits RolePermissions[]
  savedThemes         SavedTheme[]
  stockMovements      StockMovement[]

  @@map("users")
}

/// What each team role may do; admins edit it on "Roles & permissions". Admins always hold
/// everything and customers nothing, so only STAFF and DESIGNER have a row (CHECK constraint).
model RolePermissions {
  role        Role     @id
  /// Permission keys from @forgea/types; unknown keys are ignored.
  permissions String[]
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)
  updatedById String?  @db.Uuid
  updatedBy   User?    @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  @@map("role_permissions")
}
