/// One refresh token. The token itself is a random opaque string held only in the user's
/// httpOnly cookie; we store its SHA-256 hash. Every refresh rotates it (new row, old row
/// revoked). Presenting an already-revoked token means it was stolen and replayed, so the
/// whole family (every token descended from that login) is revoked.
model Session {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  /// Shared by all rotations of one login.
  familyId  String    @db.Uuid
  expiresAt DateTime  @db.Timestamptz(3)
  revokedAt DateTime? @db.Timestamptz(3)
  /// Set when it was replaced by rotation (its revokedAt too); null when ended otherwise.
  rotatedAt DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  ipAddress String?   @db.Inet
  userAgent String?

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
  @@map("sessions")
}

/// The 6-digit code emailed to confirm a new email + password account (and again when an
/// unconfirmed account signs in). One live code per account; only its HMAC is stored, so a copy
/// of the database can't reveal it. Deleted when used; useless once expired or out of tries.
model EmailCode {
  userId       String   @id @db.Uuid
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash     String
  expiresAt    DateTime @db.Timestamptz(3)
  /// Wrong codes left before this one stops working (CHECK >= 0).
  attemptsLeft Int
  /// Wrong codes over the account's life (not reset by a new code): past the limit, none works.
  wrongTotal   Int      @default(0)
  /// When it was emailed: a new one is sent at most once a minute.
  sentAt       DateTime @default(now()) @db.Timestamptz(3)

  @@map("email_codes")
}
