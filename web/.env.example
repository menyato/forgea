# Copy to web/.env for local development. Never commit web/.env.
# The storefront's own server calls the API here (browsers never do).
API_URL=http://localhost:3000
# The API's address as browsers see it (Google sign-in links).
PUBLIC_API_URL=http://localhost:3000
# This site's origin; form posts from anywhere else are refused.
PUBLIC_WEB_URL=http://localhost:5173
# Same value as INTERNAL_PROXY_SECRET in api/.env.
INTERNAL_PROXY_SECRET=
# Production only, behind Cloudflare: forward each shopper's real IP to the API.
TRUST_CLOUDFLARE=false
