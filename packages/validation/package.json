{
  "name": "@forgea/validation",
  "description": "class-validator DTO classes shared by api and web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": [
    "./dist/index.js"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./constants": {
      "types": "./dist/constants.d.ts",
      "default": "./dist/constants.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@forgea/text3d": "workspace:*",
    "@forgea/types": "workspace:*",
    "class-transformer": "catalog:",
    "class-validator": "catalog:",
    "libphonenumber-js": "catalog:",
    "reflect-metadata": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
